<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="KucukYaziBoyutu">12</x:Double>
    <x:Double x:Key="NormalYaziBoyutu">14</x:Double>
    <x:Double x:Key="OrtaYaziBoyutu">16</x:Double>
    <x:Double x:Key="BuyukYaziBoyutu">18</x:Double>
    <x:Double x:Key="BaslikYaziBoyutu">22</x:Double>
    <x:Double x:Key="SonucYaziBoyutu">46</x:Double>
    <x:Double x:Key="GecmisYaziBoyutu">15</x:Double>

   
    <Color x:Key="SayfaArkaPlanAcik">#F3F3F3</Color>
    <Color x:Key="SayfaArkaPlanKoyu">#202020</Color>

    <!-- Kart / Panel Arka Plan Rengi -->
    <Color x:Key="PanelArkaPlanAcik">#FFFFFF</Color>
    <Color x:Key="PanelArkaPlanKoyu">#2D2D2D</Color>

    <!-- Metin Renkleri -->
    <Color x:Key="AnaMetinRengiAcik">#1C1C1C</Color>
    <Color x:Key="AnaMetinRengiKoyu">#FFFFFF</Color>
    <Color x:Key="IkincilMetinRengiAcik">#686868</Color>
    <Color x:Key="IkincilMetinRengiKoyu">#9E9E9E</Color>

    <!-- Buton Renkleri: Rakamlar -->
    <Color x:Key="RakamButonArkaPlanAcik">#FFFFFF</Color>
    <Color x:Key="RakamButonArkaPlanKoyu">#3B3B3B</Color>

    <!-- Buton Renkleri: İşlemler & Fonksiyonlar -->
    <Color x:Key="IslemButonArkaPlanAcik">#F9F9F9</Color>
    <Color x:Key="IslemButonArkaPlanKoyu">#323232</Color>

    <!-- Buton Renkleri: Eşittir Butonu (Vurgu Rengi) -->
    <Color x:Key="EsittirButonArkaPlanAcik">#0067C0</Color>
    <Color x:Key="EsittirButonArkaPlanKoyu">#4CC2FF</Color>
    <Color x:Key="EsittirButonMetinAcik">#FFFFFF</Color>
    <Color x:Key="EsittirButonMetinKoyu">#000000</Color>

    <!-- Buton Kenarlık ve Vurgular -->
    <Color x:Key="ButonKenarlikRengiAcik">#E5E5E5</Color>
    <Color x:Key="ButonKenarlikRengiKoyu">#2B2B2B</Color>

    <!-- Aktif Mod / Vurgu Rengi (Örn: DEG butonu seçili) -->
    <Color x:Key="VurguRengiAcik">#005FB8</Color>
    <Color x:Key="VurguRengiKoyu">#60CDFF</Color>

    <!-- Hata Durumu Metin Rengi -->
    <Color x:Key="HataMetinRengiAcik">#C42B1C</Color>
    <Color x:Key="HataMetinRengiKoyu">#FF99A4</Color>

    <!-- Shell ve Menü İçin Metalik Gri Renkleri -->
    <Color x:Key="MetalikGriAcik">#BDC4CC</Color>
    <Color x:Key="MetalikGriKoyu">#2E343D</Color>
    <Color x:Key="MetalikGriMetinAcik">#1A202C</Color>
    <Color x:Key="MetalikGriMetinKoyu">#F0F4F8</Color>

   
    <!-- ORTAK TEMEL BUTON STİLİ -->
    <Style x:Key="TemelButonStili" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BuyukYaziBoyutu}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ButonKenarlikRengiAcik}, Dark={StaticResource ButonKenarlikRengiKoyu}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RakamButonArkaPlanAcik}, Dark={StaticResource RakamButonArkaPlanKoyu}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.65" />
                            <Setter Property="Scale" Value="0.97" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.38" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ÖRTÜK (IMPLICIT) BUTON STİLİ: Sayfalardaki butonlar için varsayılan stil -->
    <Style TargetType="Button" BasedOn="{StaticResource TemelButonStili}" />

    <!-- AÇIK STİL 1: Rakam Buton Stili (0-9 ve virgül, BasedOn ile türetildi) -->
    <Style x:Key="RakamButonStili" TargetType="Button" BasedOn="{StaticResource TemelButonStili}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RakamButonArkaPlanAcik}, Dark={StaticResource RakamButonArkaPlanKoyu}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource BuyukYaziBoyutu}" />
    </Style>

    <!-- AÇIK STİL 2: İşlem Buton Stili (+, -, ×, ÷, CE, C, Silme, BasedOn ile türetildi) -->
    <Style x:Key="IslemButonStili" TargetType="Button" BasedOn="{StaticResource TemelButonStili}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource IslemButonArkaPlanAcik}, Dark={StaticResource IslemButonArkaPlanKoyu}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
        <Setter Property="FontSize" Value="{StaticResource OrtaYaziBoyutu}" />
    </Style>

    <!-- AÇIK STİL 3: Eşittir Buton Stili (= butonu, BasedOn ile türetildi) -->
    <Style x:Key="EsittirButonStili" TargetType="Button" BasedOn="{StaticResource TemelButonStili}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource EsittirButonArkaPlanAcik}, Dark={StaticResource EsittirButonArkaPlanKoyu}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource EsittirButonMetinAcik}, Dark={StaticResource EsittirButonMetinKoyu}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource BaslikYaziBoyutu}" />
    </Style>

    <!-- AÇIK STİL 4: Fonksiyon Buton Stili (sin, cos, log, ln, 1/x, √x vb., BasedOn ile türetildi) -->
    <Style x:Key="FonksiyonButonStili" TargetType="Button" BasedOn="{StaticResource TemelButonStili}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource IslemButonArkaPlanAcik}, Dark={StaticResource IslemButonArkaPlanKoyu}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
        <Setter Property="FontSize" Value="{StaticResource NormalYaziBoyutu}" />
    </Style>

    <!-- AÇIK STİL 5: Bellek Buton Stili (MC, MR, M+, M-, MS, BasedOn ile türetildi) -->
    <Style x:Key="BellekButonStili" TargetType="Button" BasedOn="{StaticResource TemelButonStili}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource IkincilMetinRengiAcik}, Dark={StaticResource IkincilMetinRengiKoyu}}" />
        <Setter Property="FontSize" Value="{StaticResource KucukYaziBoyutu}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>



    <!-- Başlık Label Stili ("Standart", "Bilimsel", "Ayarlar") -->
    <Style x:Key="BaslikLabelStili" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource BaslikYaziBoyutu}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Hesap Makinesi Üst İşlem Geçmişi Gösterge Stili -->
    <Style x:Key="EkranGecmisStili" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource GecmisYaziBoyutu}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource IkincilMetinRengiAcik}, Dark={StaticResource IkincilMetinRengiKoyu}}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Hesap Makinesi Büyük Sonuç Ekranı Stili -->
    <Style x:Key="EkranSonucStili" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SonucYaziBoyutu}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="End" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Ayarlar Sayfası Kartı/Bölümü Stili -->
    <Style x:Key="AyarKartiStili" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PanelArkaPlanAcik}, Dark={StaticResource PanelArkaPlanKoyu}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ButonKenarlikRengiAcik}, Dark={StaticResource ButonKenarlikRengiKoyu}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

    <!-- Ayarlar Sayfası Başlık Metni Stili -->
    <Style x:Key="AyarBaslikStili" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource OrtaYaziBoyutu}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AnaMetinRengiAcik}, Dark={StaticResource AnaMetinRengiKoyu}}" />
    </Style>

    <!-- Ayarlar Sayfası Alt Açıklama Metni Stili -->
    <Style x:Key="AyarAciklamaStili" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource KucukYaziBoyutu}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource IkincilMetinRengiAcik}, Dark={StaticResource IkincilMetinRengiKoyu}}" />
    </Style>

</ResourceDictionary>
